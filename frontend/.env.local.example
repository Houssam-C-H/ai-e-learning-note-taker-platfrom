# ─────────────────────────────────────────────────────────────────────────────
# NoteAI Environment Configuration
# Copy this file to .env.local (frontend/.env.local) and populate your keys.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API endpoint (Optional: leave empty to use Next.js built-in API proxy)
NEXT_PUBLIC_API_URL=http://localhost:8000

# App Branding
NEXT_PUBLIC_APP_NAME=NoteAI
NEXT_PUBLIC_APP_VERSION=1.0.0

# Active AI Synthesis Engine: "groq" | "gemini" | "openai"
AI_PROVIDER=groq

# ── Groq Cloud (Recommended: Ultra-fast LPU inference, generous free tier) ──
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Google Gemini (Recommended: 1M token context, 100% free) ───────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenAI (Optional: GPT-4o / GPT-4o-mini, requires paid credit balance) ────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Default University BigBlueButton Server Base URL
BBB_BASE_URL=https://visioconference.supmti.ac.ma

# Speech-To-Text Whisper Model (base, small, medium, large-v3)
WHISPER_MODEL=base
