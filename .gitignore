venv/
.venv/
env/
.env_dir/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Testing
.pytest_cache/
.tox/
.coverage
coverage.xml
htmlcov/
*.cover

# Type checkers
.mypy_cache/
.dmypy.json
.pyre/
.pytype/

# Ruff
.ruff_cache/

