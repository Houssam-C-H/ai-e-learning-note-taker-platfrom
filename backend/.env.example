# Database (Async PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/elearning

# Redis / Celery broker and result backend
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=elearning-assets
MINIO_SECURE=false

# OpenAI API Key for lecture synthesis and notes generation
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Faster-Whisper Speech-To-Text configuration
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# CORS configuration (JSON array or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000"]

