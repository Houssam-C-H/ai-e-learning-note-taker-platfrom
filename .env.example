# ─────────────────────────────────────────────────────────────────────────────
# NoteAI Root Environment Template
# ─────────────────────────────────────────────────────────────────────────────

# AI Engines (Configure one or more)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Backend Database & Cache (Docker / Local)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/elearning
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=elearning-assets
MINIO_SECURE=false

# University BigBlueButton Server
BBB_BASE_URL=https://visioconference.supmti.ac.ma

